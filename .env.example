# Local synthetic run. Live service mode must set all production secrets below.
KAVACH_ENV=demo
DB_PATH=./data/kavach.sqlite3
SESSION_SECRET=local-demo-session-secret-change-me

# Telegram live bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PARENT_TELEGRAM_ID=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=

# Nebius Token Factory, OpenAI-compatible /v1/chat/completions
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=
MODEL_INPUT_COST_PER_MILLION_INR=0
MODEL_OUTPUT_COST_PER_MILLION_INR=0

# Tavily Search and Extract
TAVILY_API_KEY=

# Required in production: OpenAI-compatible /v1/audio/transcriptions for audio/video.
# Images use local Tesseract OCR; videos also need ffmpeg.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# Generate independent random values for production. AUDIT_HMAC_KEY: >= 16 bytes.
AUDIT_HMAC_KEY=
